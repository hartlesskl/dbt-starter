**/data/raw/
*.duckdb
*.duckdb.wal
*.parquet
# Local settings, with room for a committed example
.env.*
!.env.example
.DS_Store
# Planning and assistant working files are kept locally and are not published
.planning/
.claude/
# The assembled Pages site is built output
site/
